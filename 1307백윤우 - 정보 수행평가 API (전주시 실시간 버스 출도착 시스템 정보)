    gap:14px;
    font-size:15px;
    font-weight:900;
}

.logo-icon{
    width:40px;
    height:40px;
    border-radius:50%;
    background:linear-gradient(135deg,#ff5b7f,#ff9bb4);
    box-shadow:0 4px 14px rgba(255,91,127,0.3);
}

.container{
    max-width:1080px;
    margin:36px auto;
    padding:0 20px;
}

.hero{
    background:white;
    border-radius:18px;
    padding:38px;
    box-shadow:0 12px 35px rgba(0,0,0,0.05);
}

h1{
    font-size:52px;
    line-height:1.15;
    font-weight:900;
    margin-bottom:32px;
    letter-spacing:-2px;
}

.search-area{
    display:flex;
    gap:16px;
    align-items:center;
    margin-bottom:28px;
}

.search-label{
    font-size:26px;
    font-weight:800;
    white-space:nowrap;
}

.search-box{
    flex:1;
    height:58px;
    border:2px solid #dfe6ef;
    border-radius:16px;
    padding:0 20px;
    font-size:15px;
    transition:0.2s;
    outline:none;
}

.search-box:focus{
    border-color:#1677ff;
    box-shadow:0 0 0 5px rgba(22,119,255,0.1);
}

.search-btn{
    width:110px;
    height:58px;
    border:none;
    border-radius:16px;
    background:#1677ff;
    color:white;
    font-size:15px;
    font-weight:800;
    cursor:pointer;
    transition:0.2s;
}

.search-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 8px 18px rgba(22,119,255,0.28);
}

.search-result-title{
    font-size:16px;
    color:#666;
    margin-bottom:16px;
    font-weight:700;
}

.station-list{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    margin-bottom:36px;
}

.station-chip{
    padding:10px 14px;
    border-radius:16px;
    background:#f3f6fb;
    color:#333;
    font-size:15px;
    font-weight:700;
    cursor:pointer;
    transition:0.18s;
    border:1px solid transparent;
}

.station-chip:hover{
    border-color:#1677ff;
    color:#1677ff;
}

.station-chip.active{
    background:#edf4ff;
    color:#1677ff;
}

.station-info{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:22px;
    gap:20px;
}

.station-name{
    font-size:28px;
    font-weight:900;
}

.station-id{
    margin-left:12px;
    font-size:15px;
    background:#edf4ff;
    color:#1677ff;
    padding:8px 14px;
    border-radius:999px;
    font-weight:700;
}

.time{
    color:#666;
    font-size:20px;
    font-weight:600;
}

