    border:1px solid #edf0f5;
    border-radius:26px;
    padding:22px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:18px;
    box-shadow:0 5px 14px rgba(0,0,0,0.03);
