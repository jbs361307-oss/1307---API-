function renderStations(){

    const stationList =
    document.getElementById('stationList');

    stationList.innerHTML = '';

    stationCandidates.forEach((station,index)=>{

        const div = document.createElement('div');

        div.className =
        `station-chip ${index === 0 ? 'active' : ''}`;

        div.innerText = station.name;

        div.onclick = ()=>{

            document
            .querySelectorAll('.station-chip')
            .forEach(chip=>chip.classList.remove('active'));

            div.classList.add('active');

            document.querySelector('.station-name').innerHTML =
            `📍 ${station.name}`;

            document.querySelector('.station-id').innerHTML =
            `정류장 ID : ${station.id}`;

            renderBuses(station.name);
        };

        stationList.appendChild(div);
    });
}

function renderBuses(station='객사'){

    const container =
    document.getElementById('busContainer');

    container.innerHTML = '';

    const buses = busData[station] || [];

    buses.forEach(bus=>{

        const isMain = bus.type === '간선';

        container.innerHTML += `

        <div class="bus-card">

            <div class="left">

                <div class="tag ${isMain ? 'main' : 'normal'}">
                    ${bus.type}
                </div>

                <div>
                    <div class="route">
                        ${bus.number}
                    </div>

                    <div class="route-detail">
                        ${bus.route}
                    </div>
                </div>

            </div>

            <div class="arrival">
                <div class="arrival-time">
                    ${bus.time}
                </div>

                <div class="arrival-sub">
                    ${bus.distance}
                </div>
            </div>

            <div class="low-floor">
                저상
            </div>

        </div>

        `;
    });
}


function updateTime(){

    const now = new Date();

    const text =
    `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;

    document.getElementById('timeText').innerText =
    `조회 시간 : ${text}`;
}

function searchStation(){

    const value =
    document.getElementById('searchInput').value.trim();

    if(!value){

        alert('정류장을 입력하세요.');
        return;
    }

    updateTime();

    const foundStation = stationCandidates.find(station =>
        station.name.includes(value)
    );

    if(foundStation){

        document.querySelector('.station-name').innerHTML =
        `📍 ${foundStation.name}`;

        document.querySelector('.station-id').innerHTML =
        `정류장 ID : ${foundStation.id}`;

        document
        .querySelectorAll('.station-chip')
        .forEach(chip=>chip.classList.remove('active'));

        const chips =
        document.querySelectorAll('.station-chip');

        stationCandidates.forEach((station,index)=>{

            if(station.name === foundStation.name){
                chips[index].classList.add('active');
            }
        });

        renderBuses(foundStation.name);

    }else{

        document.querySelector('.station-name').innerHTML =
        `📍 ${value}`;

        document.querySelector('.station-id').innerHTML =
        `정류장 ID : 정보 없음`;

        const container =
        document.getElementById('busContainer');

        container.innerHTML = `

        <div style="padding:40px; text-align:center; color:#777; font-size:24px; font-weight:700;">
            검색된 정류장 정보가 없습니다.
        </div>

        `;
    }
}

renderStations();
renderBuses();
updateTime();

setInterval(updateTime,1000);

</script>

