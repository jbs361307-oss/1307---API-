.normal{
    background:#dff4ff;
    color:#0080c7;
}

.main{
    background:#e8e4ff;
    color:#5a4fff;
}

.route{
    font-size:34px;
    font-weight:900;
}

.route-detail{
    margin-top:6px;
    color:#666;
    font-size:15px;
}

.arrival{
    text-align:center;
